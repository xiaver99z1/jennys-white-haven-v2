generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================
// Better Auth Models
// ======================
model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  emailVerified          Boolean   @default(false)
  image                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  role                   String?   @default("receptionist")

  // Activation & Security Tokens
  activationToken        String?   @unique
  activationTokenExpires DateTime?

  // Rate Limiting for Email Verification (Max 3 per day)
  activationEmailCount      Int       @default(0)
  lastActivationEmailSentAt DateTime?

  // Better-Auth plugin fields
  banned                 Boolean?  @default(false)
  banReason              String?
  banExpires             DateTime?

  sessions               Session[]
  accounts               Account[]
  activityLogs           ActivityLog[] // ← Added missing opposite relation field
  payments               Payment[]
  notifications          Notification[]

  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Required by Better-Auth Admin Plugin
  impersonatedBy String?

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String   // The user who performed the action (The Actor)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // e.g., USER_CREATED, SESSION_REVOKED, LOGIN
  description String   // Human-readable summary of what they did
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("activity_log")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
}

model Room {
  id            String     @id @default(cuid())
  roomNumber    String     @unique
  name          String
  type          String
  description   String?
  capacity      Int        @default(2)
  pricePerNight Decimal    @db.Decimal(10, 2)
  status        RoomStatus @default(AVAILABLE)
  amenities     String[]   @default([])
  images        String[]   @default([])
  
  // Soft Delete Field
  deletedAt     DateTime?  // NULL = active room, Timestamp = deleted/archived

  bookings      Booking[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([type])
  @@index([deletedAt]) // Index for fast filtering of non-deleted rooms
  @@map("room")
}

model Guest {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String?   @unique
  phone           String
  idType          String?   // e.g., "Passport", "Driver's License", "National ID"
  idNumber        String?
  nationality     String?   @default("Filipino")
  specialNotes    String?   // Allergies, special requests, VIP notes

  // Soft Delete Field
  deletedAt       DateTime? // NULL = active guest, Timestamp = deleted/archived

  bookings        Booking[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([lastName, firstName])
  @@index([phone])
  @@index([deletedAt])
  @@map("guest")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

model Booking {
  id               String        @id @default(cuid())
  bookingReference String        @unique
  roomId           String
  room             Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guestId          String
  guest            Guest         @relation(fields: [guestId], references: [id], onDelete: Restrict)

  checkIn          DateTime
  checkOut         DateTime
  nights           Int           @default(1)
  guestsCount      Int           @default(2)

  totalAmount      Decimal       @db.Decimal(10, 2)
  amountPaid       Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentMethod    String?

  status           BookingStatus @default(PENDING)
  specialRequests  String?

  deletedAt        DateTime?

  payments         Payment[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([roomId])
  @@index([guestId])
  @@index([status])
  @@index([paymentStatus])
  @@index([checkIn, checkOut])
  @@index([deletedAt])
  @@map("booking")
}

model Payment {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(10, 2)
  method       String
  referenceNo  String?
  notes        String?
  receivedById String?
  receivedBy   User?    @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  paidAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([bookingId])
  @@index([paidAt])
  @@map("payment")
}

model Notification {
  id        String    @id @default(cuid())
  type      String
  title     String
  message   String
  href      String    @default("/admin")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([isRead, createdAt])
  @@index([userId])
  @@map("notification")
}